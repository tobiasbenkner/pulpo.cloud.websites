---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { config } from "../data/config";

const gc = config.locations.granCanaria;

const services = [
  {
    icon: "lucide:file-text",
    title: "Gestoría",
    accent: "from-gold-600 to-gold-400",
    number: "01",
    description: "Nos esmeramos por atender a nuestros clientes ofreciendo diversos campos de actuación en el ámbito de la gestoría administrativa.",
    items: [
      "Traspaso de vehículos",
      "Matriculación de vehículos extranjeros",
      "Trámites de permisos de conducir",
      "Trámites de carnet y ficha técnica de vehículos",
      "Contratos de compraventa de vehículos",
      "Trámites de importación de vehículos",
      "Trámites inmobiliarios",
      "Transmisiones patrimoniales por inmuebles",
      "Altas de establecimientos (Ayuntamientos y Gobierno Autónomo)",
      "Registros de patentes, marcas y nombres comerciales",
    ],
  },
  {
    icon: "lucide:calculator",
    title: "Servicios Fiscales",
    accent: "from-navy-600 to-navy-400",
    number: "02",
    description: "Ofrecemos un servicio fiscal completo desde nuestras sedes en Gran Canaria y Fuerteventura.",
    items: [
      "Asesoramiento fiscal general",
      "Asesoramiento fiscal particular de cada empresa",
      "Gestión fiscal (Agencia Tributaria y Consejería de Economía y Hacienda)",
      "Contabilidad fiscal y cuentas anuales (Registro Mercantil y Administraciones Públicas)",
      "Altas de empresas, fusiones y escisiones",
      "Cierre de empresas, liquidaciones y autoliquidaciones",
    ],
  },
  {
    icon: "lucide:users",
    title: "Asesoría Laboral",
    accent: "from-teal-600 to-teal-700",
    number: "03",
    description: "Garantizamos la entrega de los documentos con una antelación mínima de diez días antes de su vencimiento en el marco de un asesoramiento laboral continuo.",
    items: [
      "Confección de nóminas y contratos de trabajo",
      "Confección de los seguros sociales (TC)",
      "Defensa en el SEMAC ante diferencias con trabajadores",
      "Confección de modelos para la Hacienda estatal y regional",
      "Libros de visita",
      "Residencia a extranjeros y obtención de N.I.E.",
      "Seguridad laboral",
    ],
  },
  {
    icon: "lucide:shield-check",
    title: "Seguros",
    accent: "from-gold-700 to-gold-500",
    number: "04",
    description: "Como mediadores de varias compañías de seguros, ofrecemos todo tipo de coberturas para particulares y empresas.",
    items: [
      "Seguro de hogar",
      "Seguro de negocio",
      "Seguro de motos",
      "Seguro de vehículo",
      "Seguro de construcción",
      "Seguro de barcos",
      "Seguro de vida",
      "Plan de pensiones",
      "Plan de jubilación",
      "Seguro para animales",
    ],
  },
];
---

<Layout title="Servicios">
  <!-- Page header -->
  <section class="bg-navy-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]">
      <div class="w-full h-full bg-diagonals"></div>
    </div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[300px] bg-gold-500/5 rounded-full blur-3xl translate-y-1/2 translate-x-1/4"></div>
    <div class="absolute top-0 left-0 w-[300px] h-[300px] bg-teal-700/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/4"></div>
    <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-8 bg-gold-500"></div>
        <p class="text-gold-400 text-xs font-medium tracking-[0.25em] uppercase">Lo Que Ofrecemos</p>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-5">Nuestros Servicios</h1>
      <p class="text-navy-300 max-w-2xl text-lg leading-relaxed">
        Cuatro áreas de especialización para cubrir todas sus necesidades fiscales, laborales y administrativas.
      </p>
    </div>
    <div class="h-px bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
  </section>

  <!-- Quick nav -->
  <section class="bg-white border-b border-warm-200 sticky top-20 z-40" id="service-nav">
    <div class="max-w-7xl mx-auto px-6">
      <nav class="flex gap-1 overflow-x-auto py-1 -mb-px">
        {services.map((s) => (
          <a
            href={`#${s.title.toLowerCase().replace(/\s+/g, '-').normalize('NFD').replace(/[\u0300-\u036f]/g, '')}`}
            data-nav-target={s.title.toLowerCase().replace(/\s+/g, '-').normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
            class="service-nav-link flex items-center gap-2 px-5 py-3 text-sm font-medium text-navy-500 hover:text-navy-900 border-b-2 border-transparent hover:border-gold-500 transition-all whitespace-nowrap"
          >
            <Icon name={s.icon} class="w-4 h-4" />
            {s.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <script>
    const initScrollSpy = () => {
      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const navLinks = document.querySelectorAll<HTMLAnchorElement>(".service-nav-link");

      if (!sections.length || !navLinks.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              navLinks.forEach((link) => {
                const isActive = link.dataset.navTarget === id;
                link.classList.toggle("text-navy-900", isActive);
                link.classList.toggle("border-gold-500", isActive);
                link.classList.toggle("text-navy-500", !isActive);
                link.classList.toggle("border-transparent", !isActive);
              });
              history.replaceState(null, "", `#${id}`);
            }
          });
        },
        { rootMargin: "-30% 0px -60% 0px" }
      );

      sections.forEach((section) => {
        if (section.dataset.navTarget !== undefined || navLinks.length > 0) {
          observer.observe(section);
        }
      });
    };

    initScrollSpy();
    document.addEventListener("astro:page-load", initScrollSpy);
  </script>

  <!-- Services -->
  {services.map((service, i) => {
    const isReversed = i % 2 !== 0;
    const bgClass = i % 2 === 0 ? "bg-white" : "bg-warm-50";
    return (
      <section
        id={service.title.toLowerCase().replace(/\s+/g, '-').normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
        class:list={["relative scroll-mt-[8rem] overflow-hidden", bgClass]}
      >
        {/* Background patterns - alternating */}
        {i % 2 !== 0 && (
          <div class="absolute inset-0 bg-dots opacity-15"></div>
        )}
        {i % 2 === 0 && (
          <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-gold-50 rounded-full blur-3xl opacity-40 -translate-y-1/3 translate-x-1/4"></div>
        )}

        <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
          {/* Section number - large decorative */}
          <div class:list={[
            "absolute top-8 font-heading text-[10rem] md:text-[14rem] font-bold leading-none text-warm-100/60 select-none pointer-events-none",
            isReversed ? "right-6 md:right-12" : "left-6 md:left-12",
            i % 2 !== 0 && "text-warm-200/40"
          ]}>
            {service.number}
          </div>

          <div class:list={[
            "relative grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start",
          ]}>
            {/* Header card */}
            <div class:list={[
              "lg:col-span-4 lg:sticky lg:top-[8.5rem]",
              isReversed ? "lg:order-2" : "lg:order-1"
            ]}>
              <div class="bg-navy-900 relative overflow-hidden">
                {/* Decorative corner gradient */}
                <div class="absolute top-0 right-0 w-32 h-32">
                  <div class={`absolute top-0 right-0 w-full h-full bg-gradient-to-bl ${service.accent} opacity-10`}></div>
                </div>
                <div class="absolute bottom-0 left-0 w-24 h-24">
                  <div class="absolute bottom-0 left-0 w-full h-full bg-gradient-to-tr from-navy-800 to-transparent opacity-50"></div>
                </div>

                {/* Top accent line */}
                <div class={`h-1 bg-gradient-to-r ${service.accent}`}></div>

                <div class="p-8 md:p-10">
                  <div class="flex items-center justify-between mb-6">
                    <div class={`w-14 h-14 flex items-center justify-center bg-gradient-to-br ${service.accent} text-white`}>
                      <Icon name={service.icon} class="w-7 h-7" />
                    </div>
                    <span class="font-heading text-5xl font-bold text-navy-700">{service.number}</span>
                  </div>

                  <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">{service.title}</h2>
                  <div class="h-px w-16 bg-gradient-to-r from-gold-500 to-transparent mb-5"></div>
                  <p class="text-navy-300 text-sm leading-relaxed">{service.description}</p>

                  <div class="mt-8 pt-6 border-t border-navy-700 flex items-center justify-between">
                    <a
                      href="/contacto"
                      class="inline-flex items-center gap-2 text-gold-400 hover:text-gold-300 text-sm font-medium transition-colors"
                    >
                      Solicitar información
                      <Icon name="lucide:arrow-right" class="w-4 h-4" />
                    </a>
                    <span class="text-navy-600 text-xs">{service.items.length} servicios</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Items grid */}
            <div class:list={[
              "lg:col-span-8",
              isReversed ? "lg:order-1" : "lg:order-2"
            ]}>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {service.items.map((item, j) => (
                  <div class="group flex items-start gap-4 p-5 bg-white border border-warm-200 hover:border-gold-400 hover:shadow-lg hover:shadow-gold-500/5 transition-all duration-300 relative overflow-hidden">
                    {/* Hover accent */}
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-gold-500 to-gold-300 scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>

                    <div class="flex-shrink-0 mt-0.5 pl-1">
                      <div class="w-8 h-8 flex items-center justify-center bg-gold-50 text-gold-600 group-hover:bg-gold-500 group-hover:text-white text-xs font-bold transition-colors duration-300">
                        {String(j + 1).padStart(2, '0')}
                      </div>
                    </div>
                    <span class="text-sm text-navy-700 font-medium leading-snug pt-1">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        {i < services.length - 1 && (
          <div class="gold-divider max-w-5xl mx-auto"></div>
        )}
      </section>
    );
  })}

  <!-- CTA -->
  <section class="bg-navy-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="w-full h-full bg-crossgrid"></div>
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-gold-500/5 rounded-full blur-3xl -translate-y-1/2"></div>

    <div class="h-px bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>

    <div class="relative max-w-4xl mx-auto px-6 py-20 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-gold-400 text-xs font-medium tracking-[0.25em] uppercase mb-3">Primer Paso</p>
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">
            ¿Le podemos ayudar?
          </h2>
          <p class="text-navy-300 leading-relaxed">
            Contacte con nosotros para una consulta personalizada sin compromiso. Le asesoramos sobre el servicio que mejor se adapta a sus necesidades.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-4 md:items-end">
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold px-8 py-3.5 text-sm tracking-wide uppercase transition-colors"
          >
            <Icon name="lucide:mail" class="w-4 h-4" />
            Contactar
          </a>
          <a
            href={`tel:${gc.phone[0].replace(/\s/g, "")}`}
            class="inline-flex items-center justify-center gap-2 border border-navy-600 hover:border-gold-500 text-white hover:text-gold-400 px-8 py-3.5 text-sm tracking-wide uppercase transition-colors"
          >
            <Icon name="lucide:phone" class="w-4 h-4" />
            {gc.phone[0]}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
