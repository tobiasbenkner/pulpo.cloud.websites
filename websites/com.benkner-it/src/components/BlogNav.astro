---
import { type Language, resolveTranslations } from '@/lib/i18n';
import { defaultLang } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { sharedTranslations } from '@/lib/shared.i18n';
import { categories } from '@/lib/posts';

interface Props {
  lang: Language;
  activeCategory?: string;
}

const { lang, activeCategory } = Astro.props;
const t = resolveTranslations(sharedTranslations, lang);
const isDefaultLang = lang === defaultLang;
const blogHref = getTranslatedPath('blog', lang);

const items = [
  {
    label: lang === 'de' ? 'Alle' : 'All',
    href: blogHref,
    active: !activeCategory,
  },
  ...categories.map((cat) => ({
    label: (t.categories as Record<string, string>)[cat] ?? cat,
    href: isDefaultLang ? `/blog/${cat}` : `/${lang}/blog/${cat}`,
    active: activeCategory === cat,
  })),
];
---

<nav class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 scrollbar-hide">
  {
    items.map(({ label, href, active }) => (
      <a
        href={href}
        class:list={[
          'shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-colors whitespace-nowrap',
          active
            ? 'bg-primary text-white'
            : 'bg-surface border border-border text-muted hover:text-heading hover:border-border-hover',
        ]}
      >
        {label}
      </a>
    ))
  }
</nav>
