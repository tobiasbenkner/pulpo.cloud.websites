---
import { Icon } from 'astro-icon/components';
import { type Language, resolveTranslations } from '@/lib/i18n';
import { defaultLang } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { sharedTranslations } from '@/lib/shared.i18n';
import { categories } from '@/lib/posts';

interface Props {
  lang: Language;
  activeCategory?: string;
}

const { lang, activeCategory } = Astro.props;
const t = resolveTranslations(sharedTranslations, lang);
const isDefaultLang = lang === defaultLang;
const blogHref = getTranslatedPath('blog', lang);

const categoryIcons: Record<string, string> = {
  devops: 'lucide:server',
  web: 'lucide:globe',
  ai: 'lucide:brain',
  tooling: 'lucide:wrench',
  thoughts: 'lucide:lightbulb',
};

const items = [
  {
    label: lang === 'de' ? 'Alle' : 'All',
    href: blogHref,
    active: !activeCategory,
    icon: 'lucide:layout-grid',
  },
  ...categories.map((cat) => ({
    label: (t.categories as Record<string, string>)[cat] ?? cat,
    href: isDefaultLang ? `/blog/${cat}` : `/${lang}/blog/${cat}`,
    active: activeCategory === cat,
    icon: categoryIcons[cat] ?? 'lucide:hash',
  })),
];
---

<nav class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 scrollbar-hide">
  {
    items.map(({ label, href, active, icon }) => (
      <a
        href={href}
        class:list={[
          'shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap',
          active
            ? 'bg-gradient-to-r from-primary to-primary-hover text-white shadow-sm'
            : 'bg-white border border-border text-muted hover:text-heading hover:border-border-hover hover:shadow-sm',
        ]}
      >
        <Icon name={icon} class="w-3.5 h-3.5" />
        {label}
      </a>
    ))
  }
</nav>
