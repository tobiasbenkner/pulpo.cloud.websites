---
import { Image } from 'astro:assets';

interface Props {
  url: string;
  screenshot?: ImageMetadata;
  class?: string;
}

const { url, screenshot, class: className } = Astro.props;
---

<div
  class:list={[
    'browser-mockup rounded-xl border border-border overflow-hidden bg-white transition-shadow',
    className,
  ]}
>
  <!-- Browser chrome bar -->
  <div
    class="flex items-center gap-2.5 px-4 py-2.5 bg-surface/80 border-b border-border"
  >
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#fca5a5]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#fcd34d]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#86efac]"></div>
    </div>
    <div
      class="flex-1 mx-1 py-1 px-3 rounded-md bg-white border border-border text-[11px] text-faint font-mono truncate"
    >
      {url}
    </div>
  </div>
  <!-- Screenshot area -->
  {screenshot ? (
    <Image
      src={screenshot}
      alt={url}
      width={640}
      height={400}
      class="w-full aspect-[16/10] object-cover object-top"
    />
  ) : (
    <div class="aspect-[16/10] bg-gradient-to-br from-primary-light via-white to-secondary-light relative overflow-hidden">
      <div class="absolute inset-0 p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <div class="w-16 h-3 rounded-full bg-primary/10"></div>
          <div class="flex gap-2">
            <div class="w-10 h-2 rounded-full bg-muted/10"></div>
            <div class="w-10 h-2 rounded-full bg-muted/10"></div>
            <div class="w-10 h-2 rounded-full bg-muted/10"></div>
          </div>
        </div>
        <div class="flex-1 flex flex-col justify-center gap-3 max-w-[60%]">
          <div class="w-3/4 h-4 rounded-full bg-primary/15"></div>
          <div class="w-full h-4 rounded-full bg-primary/10"></div>
          <div class="w-1/2 h-4 rounded-full bg-secondary/10"></div>
          <div class="mt-2 w-24 h-6 rounded-md bg-primary/20"></div>
        </div>
      </div>
      <slot />
    </div>
  )}
</div>
