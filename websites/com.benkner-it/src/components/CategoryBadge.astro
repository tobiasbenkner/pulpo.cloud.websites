---
import type { Category, Locale } from '@/lib/i18n';
import { t, localePath } from '@/lib/i18n';

interface Props {
  category: Category;
  lang: Locale;
  linked?: boolean;
}

const { category, lang, linked = true } = Astro.props;
const label = t(lang).categories[category];
const href = localePath(`/${category}`, lang);

const classes =
  'inline-block px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary bg-primary-light border border-primary-border rounded-md';
---

{
  linked ? (
    <a
      href={href}
      class:list={[classes, 'hover:bg-primary/10 transition-colors']}
    >
      {label}
    </a>
  ) : (
    <span class={classes}>{label}</span>
  )
}
