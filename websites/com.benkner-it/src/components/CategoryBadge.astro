---
import { type Language, resolveTranslations } from '@/lib/i18n';
import { sharedTranslations } from '@/lib/shared.i18n';
import { getCategoryUrl } from '@/lib/posts';

interface Props {
  category: string;
  lang: Language;
  linked?: boolean;
}

const { category, lang, linked = true } = Astro.props;
const t = resolveTranslations(sharedTranslations, lang);
const label = (t.categories as Record<string, string>)[category] ?? category;
const href = getCategoryUrl(category, lang);

const classes =
  'inline-block px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary bg-primary-light border border-primary-border rounded-md';
---

{
  linked ? (
    <a href={href} class:list={[classes, 'hover:bg-primary/10 transition-colors']}>
      {label}
    </a>
  ) : (
    <span class={classes}>{label}</span>
  )
}
