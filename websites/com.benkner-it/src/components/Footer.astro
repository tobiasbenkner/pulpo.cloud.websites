---
import type { Locale } from '@/lib/i18n';
import { t, localePath } from '@/lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const i18n = t(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/[0.04] bg-[#09090b]">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-6">
        <a
          href={localePath('/', lang)}
          class="font-display text-sm font-bold text-[#52525b] hover:text-[#fafaf9] transition-colors"
        >
          TB
        </a>
        <span class="text-[13px] text-[#3f3f46]">
          &copy; {year} Tobias Benkner
        </span>
      </div>

      <div class="flex items-center gap-6">
        <a
          href={localePath('/blog', lang)}
          class="text-[13px] text-[#52525b] hover:text-[#fafaf9] transition-colors"
        >
          {i18n.nav.blog}
        </a>
        <a
          href="mailto:hello@benkner-it.com"
          class="text-[13px] text-[#52525b] hover:text-accent transition-colors"
        >
          hello@benkner-it.com
        </a>
      </div>
    </div>
  </div>
</footer>
