---
import type { Locale } from '@/lib/i18n';
import { t, categories, localePath } from '@/lib/i18n';

interface Props {
  lang: Locale;
  currentPath: string;
  alternateUrl: string;
}

const { lang, currentPath, alternateUrl } = Astro.props;
const i18n = t(lang);
const alternateLang = lang === 'en' ? 'de' : 'en';

function isActive(path: string): boolean {
  const normalized = currentPath.replace(/\/$/, '') || '/';
  const target = path.replace(/\/$/, '') || '/';
  const home = localePath('/', lang).replace(/\/$/, '') || '/';
  if (target === home) return normalized === target;
  return normalized.startsWith(target);
}

const navItems = [
  ...categories.map((cat) => ({
    href: localePath(`/${cat}`, lang),
    label: i18n.categories[cat],
  })),
  { href: localePath('/blog', lang), label: i18n.nav.blog },
  { href: localePath('/about', lang), label: i18n.nav.about },
];
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a
        href={localePath('/', lang)}
        class="text-lg font-bold tracking-tight hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors"
      >
        TB
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'px-3 py-2 rounded-md text-sm transition-colors',
                isActive(href)
                  ? 'text-emerald-600 dark:text-emerald-400 font-medium'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100',
              ]}
            >
              {label}
            </a>
          ))
        }
        <span class="mx-2 text-slate-300 dark:text-slate-700">|</span>
        <a
          href={alternateUrl}
          class="px-2 py-1 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
        >
          {alternateLang.toUpperCase()}
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="md:hidden p-2 text-slate-600 dark:text-slate-400"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-4 border-t border-slate-200 dark:border-slate-800 pt-4"
    >
      <div class="flex flex-col gap-1">
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'px-3 py-2 rounded-md text-sm transition-colors',
                isActive(href)
                  ? 'text-emerald-600 dark:text-emerald-400 font-medium'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100',
              ]}
            >
              {label}
            </a>
          ))
        }
        <div class="px-3 py-2">
          <a
            href={alternateUrl}
            class="text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
          >
            {alternateLang.toUpperCase()}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
