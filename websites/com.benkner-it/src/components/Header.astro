---
import type { Locale } from '@/lib/i18n';
import { t, localePath } from '@/lib/i18n';

interface Props {
  lang: Locale;
  currentPath: string;
  alternateUrl: string;
}

const { lang, currentPath, alternateUrl } = Astro.props;
const i18n = t(lang);
const alternateLang = lang === 'en' ? 'de' : 'en';

function isActive(path: string): boolean {
  const normalized = currentPath.replace(/\/$/, '') || '/';
  const target = path.replace(/\/$/, '') || '/';
  const home = localePath('/', lang).replace(/\/$/, '') || '/';
  if (target === home) return normalized === target;
  return normalized.startsWith(target);
}

const navItems = [
  { href: localePath('/', lang), label: i18n.nav.home },
  { href: localePath('/services', lang), label: i18n.nav.services },
  { href: localePath('/projects', lang), label: i18n.nav.projects },
  { href: localePath('/blog', lang), label: i18n.nav.blog },
  { href: localePath('/contact', lang), label: i18n.nav.contact },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-[#09090b]/80 backdrop-blur-xl border-b border-white/[0.04]"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a
        href={localePath('/', lang)}
        class="font-display text-base font-bold tracking-tight text-[#fafaf9] hover:text-accent transition-colors"
      >
        TB
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'px-3 py-2 text-[13px] font-medium transition-colors',
                isActive(href)
                  ? 'text-accent'
                  : 'text-[#a1a1aa] hover:text-[#fafaf9]',
              ]}
            >
              {label}
            </a>
          ))
        }
        <span class="mx-1.5 w-px h-4 bg-white/10"></span>
        <a
          href={alternateUrl}
          class="px-2 py-1 text-[13px] font-mono font-medium text-[#52525b] hover:text-accent transition-colors"
        >
          {alternateLang.toUpperCase()}
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="md:hidden p-2 text-[#a1a1aa] hover:text-[#fafaf9] transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
        </svg>
      </button>
    </div>

    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-5 pt-3 border-t border-white/[0.04]"
    >
      <div class="flex flex-col gap-0.5">
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'px-3 py-2.5 text-sm transition-colors',
                isActive(href)
                  ? 'text-accent'
                  : 'text-[#a1a1aa] hover:text-[#fafaf9]',
              ]}
            >
              {label}
            </a>
          ))
        }
        <div class="px-3 py-2.5">
          <a
            href={alternateUrl}
            class="text-sm font-mono text-[#52525b] hover:text-accent transition-colors"
          >
            {alternateLang.toUpperCase()}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
