---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logoIcon from '@/assets/logo-icon.png';
import { type Language } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { resolveNavTree } from '@/lib/navbar';
import { config } from '@/data/config';

interface Props {
  lang: Language;
  currentPath: string;
  alternateUrl: string;
}

const { lang, currentPath, alternateUrl } = Astro.props;
const alternateLang: Language = lang === 'de' ? 'en' : 'de';
const navItems = resolveNavTree(lang, currentPath);
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-xl border-b border-border"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a
        href={getTranslatedPath('home', lang)}
        class="flex items-center gap-2.5 hover:opacity-80 transition-opacity"
      >
        <Image
          src={logoIcon}
          alt={config.company}
          width={112}
          height={128}
          class="w-7 h-auto"
          quality={100}
        />
        <span class="font-display text-sm font-bold text-heading tracking-tight">
          {config.company}
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {
          navItems.map(({ href, label, isActive }) => (
            <a
              href={href}
              class:list={[
                'nav-link relative px-3 py-2 text-[13px] font-medium transition-colors',
                isActive ? 'text-primary' : 'text-muted hover:text-heading',
              ]}
              data-active={isActive ? 'true' : undefined}
            >
              {label}
            </a>
          ))
        }
        <span class="mx-1.5 w-px h-4 bg-border"></span>
        <a
          href={alternateUrl}
          class="px-2 py-1 text-[13px] font-mono font-medium text-faint hover:text-primary transition-colors"
        >
          {alternateLang.toUpperCase()}
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="md:hidden p-2 text-muted hover:text-heading transition-colors relative z-[60]"
        aria-label="Toggle menu"
      >
        <Icon id="icon-burger" name="lucide:menu" class="w-5 h-5" />
        <Icon id="icon-close" name="lucide:x" class="w-5 h-5 hidden" />
      </button>
    </div>
  </div>
</header>

<!-- Fullscreen mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[55] bg-white hidden md:hidden flex-col"
>
  <div class="flex items-center justify-between h-16 px-5 border-b border-border">
    <a href={getTranslatedPath('home', lang)} class="flex items-center gap-2.5">
      <Image
        src={logoIcon}
        alt={config.company}
        width={112}
        height={128}
        class="w-7 h-auto"
        quality={100}
      />
      <span class="font-display text-sm font-bold text-heading tracking-tight">
        {config.company}
      </span>
    </a>
    <button
      id="menu-close"
      class="p-2 text-muted hover:text-heading transition-colors"
      aria-label="Close menu"
    >
      <Icon name="lucide:x" class="w-5 h-5" />
    </button>
  </div>

  <div class="flex flex-col justify-center items-center flex-1 gap-2">
    {
      navItems.map(({ href, label, isActive }) => (
        <a
          href={href}
          class:list={[
            'px-6 py-3 text-2xl font-display font-bold transition-colors rounded-lg',
            isActive ? 'text-primary' : 'text-heading hover:text-primary',
          ]}
        >
          {label}
        </a>
      ))
    }
    <div class="mt-6 pt-6 border-t border-border">
      <a
        href={alternateUrl}
        class="px-6 py-3 text-lg font-mono text-faint hover:text-primary transition-colors"
      >
        {alternateLang.toUpperCase()}
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('mobile-menu');
  const iconBurger = document.getElementById('icon-burger');
  const iconClose = document.getElementById('icon-close');

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    iconBurger?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    iconBurger?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
