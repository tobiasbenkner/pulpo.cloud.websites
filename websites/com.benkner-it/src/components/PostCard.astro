---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/lib/i18n';
import { localePath } from '@/lib/i18n';
import { formatDate } from '@/lib/posts';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Locale;
}

const { post, lang } = Astro.props;
const href = localePath(
  `/${post.data.category}/${post.data.permalink}`,
  lang,
);
---

<article class="group h-full">
  <a
    href={href}
    class="block h-full p-6 sm:p-7 border border-[#1e1e22] hover:border-[#27272a] bg-surface/30 transition-all card-lift"
  >
    <div class="flex items-center gap-3 mb-4">
      <CategoryBadge category={post.data.category} lang={lang} linked={false} />
      <time
        class="text-xs font-mono text-[#3f3f46]"
        datetime={post.data.date.toISOString()}
      >
        {formatDate(post.data.date, lang)}
      </time>
    </div>
    <h3
      class="font-display text-base font-bold tracking-tight group-hover:text-accent transition-colors"
    >
      {post.data.title}
    </h3>
    <p class="text-sm text-[#71717a] leading-relaxed mt-2 line-clamp-2">
      {post.data.description}
    </p>
  </a>
</article>
