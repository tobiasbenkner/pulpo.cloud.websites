---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { type Language, resolveTranslations } from '@/lib/i18n';
import { defaultLang } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { sharedTranslations } from '@/lib/shared.i18n';
import { formatDate, getPostsByLang, getPostUrl } from '@/lib/posts';
import CategoryBadge from './CategoryBadge.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PostCard from './PostCard.astro';

interface Props {
  lang: Language;
  post: CollectionEntry<'blog'>;
  alternateUrl?: string;
}

const { lang, post } = Astro.props;
const t = resolveTranslations(sharedTranslations, lang);
const category = post.data.category;
const categoryLabel = (t.categories as Record<string, string>)[category] ?? category;
const { Content } = await render(post);
const isDefaultLang = lang === defaultLang;

const body = post.body ?? '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const readingLabel = lang === 'de' ? `${readingTime} Min. Lesezeit` : `${readingTime} min read`;
const categoryHref = isDefaultLang ? `/blog/${category}` : `/${lang}/blog/${category}`;

const breadcrumbs = [
  { label: lang === 'de' ? 'Start' : 'Home', href: getTranslatedPath('home', lang) },
  { label: 'Blog', href: getTranslatedPath('blog', lang) },
  { label: categoryLabel, href: categoryHref },
  { label: post.data.title },
];

// Related posts (same category, exclude current)
const allPosts = await getPostsByLang(lang);
const relatedPosts = allPosts
  .filter((p) => p.data.category === category && p.id !== post.id)
  .slice(0, 2);
---

<!-- Article Header -->
<section class="relative pt-32 pb-0 sm:pt-40 dot-grid overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-[400px] h-[400px] bg-primary/[0.04] rounded-full blur-[100px] -translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>

  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="flex items-center gap-3 mt-6">
      <CategoryBadge category={category} lang={lang} />
      <time class="text-xs font-mono text-faint" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, lang)}
      </time>
      <span class="text-xs text-faint">·</span>
      <span class="text-xs font-mono text-faint flex items-center gap-1">
        <Icon name="lucide:clock" class="w-3 h-3" />
        {readingLabel}
      </span>
    </div>

    <h1 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold leading-tight tracking-tight text-heading mt-4">
      {post.data.title}
    </h1>
    <p class="text-muted mt-3 leading-relaxed">{post.data.description}</p>
  </div>
</section>

{post.data.cover && (
  <div class="max-w-3xl mx-auto px-5 sm:px-8 mt-10">
    <img
      src={post.data.cover.src}
      alt={post.data.title}
      width={post.data.cover.width}
      height={post.data.cover.height}
      class="w-full h-auto rounded-xl shadow-lg"
      loading="eager"
    />
  </div>
)}

<!-- Article Content -->
<section class="py-12 sm:py-16">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div
      class="prose prose-slate max-w-none
             prose-headings:font-display prose-headings:tracking-tight prose-headings:text-heading
             prose-a:text-primary prose-a:no-underline hover:prose-a:underline
             prose-code:text-primary/80 prose-code:font-mono
             prose-pre:bg-[#0f172a] prose-pre:border prose-pre:border-border prose-pre:rounded-xl
             prose-hr:border-border prose-strong:text-heading
             prose-img:rounded-xl prose-img:shadow-md"
    >
      <Content />
    </div>
  </div>
</section>

<!-- Footer: Back + Related -->
<section class="relative py-12 sm:py-20 bg-surface overflow-hidden">
  <div class="absolute inset-0 cross-grid opacity-20 pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <a
      href={categoryHref}
      class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors"
    >
      <Icon name="lucide:arrow-left" class="w-4 h-4" />
      {t.post.backTo} {categoryLabel}
    </a>

    {relatedPosts.length > 0 && (
      <div class="mt-12">
        <h3 class="font-display text-lg font-bold text-heading">
          {lang === 'de' ? 'Weitere Artikel' : 'Related Articles'}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
          {relatedPosts.map((p) => (
            <PostCard post={p} lang={lang} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
