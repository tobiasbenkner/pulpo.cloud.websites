---
import { Icon } from 'astro-icon/components';
import { config } from '@/data/config';
---

<a
  href={`https://wa.me/${config.whatsapp}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp"
  class="fixed bottom-6 right-6 z-40 w-14 h-14 bg-[#25d366] hover:bg-[#20bd5a] text-white rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all hover:scale-105"
>
  <Icon name="mdi:whatsapp" class="w-7 h-7" />
</a>
