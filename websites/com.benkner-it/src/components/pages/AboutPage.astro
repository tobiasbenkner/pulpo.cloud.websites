---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const i18n = t(lang);

const techStack = [
  {
    label: 'Infrastructure',
    items: ['Docker', 'Kubernetes', 'Traefik', 'Terraform'],
  },
  { label: 'CI/CD', items: ['GitHub Actions', 'GitLab CI'] },
  {
    label: 'Frontend',
    items: ['Astro', 'TypeScript', 'Tailwind CSS', 'React'],
  },
  { label: 'Backend', items: ['Node.js', 'Go', 'PostgreSQL'] },
  { label: 'Monitoring', items: ['Grafana', 'Prometheus', 'Loki'] },
];
---

<Base lang={lang} title={i18n.nav.about}>
  <section>
    <p class="font-mono text-[#52525b] text-xs uppercase tracking-[0.2em]">
      {i18n.aboutSection.num} — {i18n.aboutSection.label}
    </p>
    <h1
      class="font-display text-3xl sm:text-4xl font-bold mt-4 tracking-tight whitespace-pre-line leading-tight"
    >
      {i18n.aboutSection.headline}
    </h1>

    <div class="mt-10 space-y-6">
      <p class="text-[#a1a1aa] leading-relaxed">{i18n.aboutSection.bio}</p>
      <p class="text-[#71717a] leading-relaxed text-sm">
        {i18n.aboutSection.bio2}
      </p>
    </div>

    <div class="mt-16">
      <p
        class="font-mono text-[#52525b] text-xs uppercase tracking-[0.2em] mb-8"
      >
        {i18n.aboutSection.techLabel}
      </p>
      <div class="space-y-6">
        {
          techStack.map((group) => (
            <div>
              <p class="text-[11px] font-mono uppercase tracking-wider text-[#3f3f46] mb-3">
                {group.label}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="px-3 py-1.5 text-sm text-[#a1a1aa] border border-[#1e1e22] bg-surface/30">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
