---
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
  posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const i18n = t(lang);
---

<Base lang={lang} title={i18n.nav.blog}>
  <section>
    <p class="font-mono text-[#52525b] text-xs uppercase tracking-[0.2em]">
      Blog
    </p>
    <h1 class="font-display text-3xl sm:text-4xl font-bold mt-4 tracking-tight">
      {i18n.blog.headline}
    </h1>
    <div class="grid grid-cols-1 gap-4 mt-10">
      {posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>
</Base>
