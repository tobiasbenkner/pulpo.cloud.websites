---
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import type { Locale, Category } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
  category: Category;
  posts: CollectionEntry<'blog'>[];
}

const { lang, category, posts } = Astro.props;
const i18n = t(lang);
---

<Base lang={lang} title={i18n.categories[category]}>
  <section>
    <p class="font-mono text-[#52525b] text-xs uppercase tracking-[0.2em]">
      {category}
    </p>
    <h1 class="font-display text-3xl sm:text-4xl font-bold mt-4 tracking-tight">
      {i18n.categories[category]}
    </h1>
    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 mt-10">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="text-[#52525b] mt-8">{i18n.notFound}</p>
      )
    }
  </section>
</Base>
