---
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import type { Locale, Category } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
  category: Category;
  posts: CollectionEntry<'blog'>[];
}

const { lang, category, posts } = Astro.props;
const i18n = t(lang);
---

<Base lang={lang} title={i18n.categories[category]}>
  <section>
    <h1 class="text-3xl font-bold mb-8">{i18n.categories[category]}</h1>
    {
      posts.length > 0 ? (
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="text-slate-500 dark:text-slate-400">{i18n.notFound}</p>
      )
    }
  </section>
</Base>
