---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const i18n = t(lang);
---

<Base lang={lang} title={i18n.nav.contact} fullWidth>
  <section class="relative pt-32 pb-28 sm:pt-40 sm:pb-36 min-h-[80dvh] flex items-center">
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-accent/[0.03] rounded-full blur-[100px] pointer-events-none"
    >
    </div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 w-full text-center">
      <p class="font-mono text-[#52525b] text-xs uppercase tracking-[0.2em]">
        {i18n.contactSection.num} — {i18n.contactSection.label}
      </p>
      <h1
        class="font-display text-4xl sm:text-5xl md:text-7xl font-extrabold mt-8 tracking-tight"
      >
        {i18n.contactSection.headline1}<br />
        <span class="text-accent">{i18n.contactSection.headline2}</span>
      </h1>
      <p class="text-lg text-[#71717a] mt-6">
        {i18n.contactSection.subtitle}
      </p>
      <div class="mt-10">
        <a
          href={`mailto:${i18n.contactSection.cta}`}
          class="inline-flex items-center gap-3 text-xl sm:text-2xl font-mono text-accent hover:text-accent-hover transition-colors group"
        >
          {i18n.contactSection.cta}
          <svg
            class="w-5 h-5 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>
