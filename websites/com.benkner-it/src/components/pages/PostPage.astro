---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import type { Locale, Category } from '@/lib/i18n';
import { t, localePath } from '@/lib/i18n';
import { formatDate } from '@/lib/posts';

interface Props {
  lang: Locale;
  post: CollectionEntry<'blog'>;
  alternateUrl?: string;
}

const { lang, post, alternateUrl } = Astro.props;
const i18n = t(lang);
const category = post.data.category as Category;
const { Content } = await render(post);
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternateUrl={alternateUrl}
>
  <article>
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <CategoryBadge category={category} lang={lang} />
        <time
          class="text-xs font-mono text-faint"
          datetime={post.data.date.toISOString()}
        >
          {formatDate(post.data.date, lang)}
        </time>
      </div>
      <h1
        class="font-display text-2xl sm:text-3xl font-bold leading-tight tracking-tight text-heading"
      >
        {post.data.title}
      </h1>
    </header>

    <div
      class="prose prose-slate max-w-none
             prose-headings:font-display prose-headings:tracking-tight prose-headings:text-heading
             prose-a:text-primary prose-a:no-underline hover:prose-a:underline
             prose-code:text-primary/80 prose-code:font-mono
             prose-pre:bg-[#0f172a] prose-pre:border prose-pre:border-border prose-pre:rounded-xl
             prose-hr:border-border
             prose-strong:text-heading"
    >
      <Content />
    </div>

    <footer class="mt-14 pt-8 border-t border-border">
      <a
        href={localePath(`/${category}`, lang)}
        class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors"
      >
        <Icon name="lucide:arrow-left" class="w-4 h-4" />
        {i18n.post.backTo} {i18n.categories[category]}
      </a>
    </footer>
  </article>
</Base>
