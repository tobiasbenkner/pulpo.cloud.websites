---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import type { Locale, Category } from '@/lib/i18n';
import { t, localePath } from '@/lib/i18n';
import { formatDate } from '@/lib/posts';

interface Props {
  lang: Locale;
  post: CollectionEntry<'blog'>;
  alternateUrl?: string;
}

const { lang, post, alternateUrl } = Astro.props;
const i18n = t(lang);
const category = post.data.category as Category;
const { Content } = await render(post);
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternateUrl={alternateUrl}
>
  <article>
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <CategoryBadge category={category} lang={lang} />
        <time
          class="text-xs font-mono text-[#3f3f46]"
          datetime={post.data.date.toISOString()}
        >
          {formatDate(post.data.date, lang)}
        </time>
      </div>
      <h1
        class="font-display text-3xl sm:text-4xl font-bold leading-tight tracking-tight"
      >
        {post.data.title}
      </h1>
    </header>

    <div
      class="prose prose-invert prose-zinc max-w-none
             prose-headings:font-display prose-headings:tracking-tight
             prose-a:text-accent prose-a:no-underline hover:prose-a:underline
             prose-code:text-accent/80 prose-code:font-mono
             prose-pre:bg-surface prose-pre:border prose-pre:border-[#1e1e22]
             prose-hr:border-[#1e1e22]
             prose-strong:text-[#fafaf9]"
    >
      <Content />
    </div>

    <footer class="mt-14 pt-8 border-t border-white/[0.04]">
      <a
        href={localePath(`/${category}`, lang)}
        class="inline-flex items-center gap-2 text-sm text-[#52525b] hover:text-accent transition-colors font-mono"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
        </svg>
        {i18n.post.backTo} {i18n.categories[category]}
      </a>
    </footer>
  </article>
</Base>
