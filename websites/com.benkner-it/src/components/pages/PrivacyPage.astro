---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { config } from '@/data/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const { legal } = config;
---

<Base lang={lang} title={isEn ? 'Privacy Policy' : 'Datenschutzerklärung'}>
  <article class="prose prose-slate max-w-none prose-headings:font-display prose-headings:tracking-tight prose-headings:text-heading">
    <h1>{isEn ? 'Privacy Policy' : 'Datenschutzerklärung'}</h1>

    <h2>{isEn ? '1. Data Protection at a Glance' : '1. Datenschutz auf einen Blick'}</h2>
    <h3>{isEn ? 'General Information' : 'Allgemeine Hinweise'}</h3>
    <p>
      {isEn
        ? 'The following information provides a simple overview of what happens to your personal data when you visit this website. Personal data is any data that can be used to identify you personally.'
        : 'Die folgenden Hinweise geben einen einfachen Überblick darüber, was mit Ihren personenbezogenen Daten passiert, wenn Sie diese Website besuchen. Personenbezogene Daten sind alle Daten, mit denen Sie persönlich identifiziert werden können.'}
    </p>

    <h2>{isEn ? '2. Responsible Party' : '2. Verantwortliche Stelle'}</h2>
    <p>
      {isEn ? 'The responsible party for data processing on this website is' : 'Verantwortlich für die Datenverarbeitung auf dieser Website ist'}:
    </p>
    <p>
      {legal.fullName}<br />
      {legal.address.street}<br />
      {legal.address.zip} {legal.address.city}<br />
      {legal.address.country}
    </p>
    <p>
      {isEn ? 'Email' : 'E-Mail'}: <a href={`mailto:${config.email}`}>{config.email}</a>
    </p>

    <h2>{isEn ? '3. Data Collection on This Website' : '3. Datenerfassung auf dieser Website'}</h2>
    <h3>{isEn ? 'Server Log Files' : 'Server-Log-Dateien'}</h3>
    <p>
      {isEn
        ? 'The website provider automatically collects and stores information in server log files that your browser transmits to us. These are: browser type and version, operating system used, referrer URL, hostname of the accessing computer, and time of the server request. This data cannot be assigned to specific persons.'
        : 'Der Provider der Seiten erhebt und speichert automatisch Informationen in sogenannten Server-Log-Dateien, die Ihr Browser automatisch an uns übermittelt. Dies sind: Browsertyp und Browserversion, verwendetes Betriebssystem, Referrer URL, Hostname des zugreifenden Rechners und Uhrzeit der Serveranfrage. Eine Zuordnung dieser Daten zu bestimmten Personen ist nicht möglich.'}
    </p>

    <h3>{isEn ? 'Contact by Email' : 'Kontaktaufnahme per E-Mail'}</h3>
    <p>
      {isEn
        ? 'If you contact us by email, your inquiry including all personal data (name, email address) will be stored and processed by us for the purpose of handling your request. We will not share this data without your consent.'
        : 'Wenn Sie uns per E-Mail kontaktieren, wird Ihre Anfrage inklusive aller daraus hervorgehenden personenbezogenen Daten (Name, E-Mail-Adresse) zum Zwecke der Bearbeitung Ihres Anliegens bei uns gespeichert und verarbeitet. Diese Daten geben wir nicht ohne Ihre Einwilligung weiter.'}
    </p>

    <h2>{isEn ? '4. Hosting' : '4. Hosting'}</h2>
    <p>
      {isEn
        ? 'This website is hosted externally. The personal data collected on this website is stored on the servers of the host. This may include IP addresses, contact requests, meta and communication data, contract data, contact details, names, website accesses and other data generated via a website.'
        : 'Diese Website wird extern gehostet. Die personenbezogenen Daten, die auf dieser Website erfasst werden, werden auf den Servern des Hosters gespeichert. Hierbei kann es sich v.a. um IP-Adressen, Kontaktanfragen, Meta- und Kommunikationsdaten, Vertragsdaten, Kontaktdaten, Namen, Websitezugriffe und sonstige Daten, die über eine Website generiert werden, handeln.'}
    </p>

    <h2>{isEn ? '5. Your Rights' : '5. Ihre Rechte'}</h2>
    <p>
      {isEn
        ? 'You have the right to receive information about the origin, recipient and purpose of your stored personal data free of charge at any time. You also have the right to request the correction or deletion of this data. If you have given consent to data processing, you can revoke this consent at any time for the future.'
        : 'Sie haben jederzeit das Recht, unentgeltlich Auskunft über Herkunft, Empfänger und Zweck Ihrer gespeicherten personenbezogenen Daten zu erhalten. Sie haben außerdem ein Recht, die Berichtigung oder Löschung dieser Daten zu verlangen. Wenn Sie eine Einwilligung zur Datenverarbeitung erteilt haben, können Sie diese Einwilligung jederzeit für die Zukunft widerrufen.'}
    </p>
    <p>
      {isEn
        ? `For this and other questions regarding data protection, you can contact us at any time at ${config.email}.`
        : `Hierzu sowie zu weiteren Fragen zum Thema Datenschutz können Sie sich jederzeit an uns unter ${config.email} wenden.`}
    </p>
  </article>
</Base>
