---
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import BrowserMockup from '@/components/BrowserMockup.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const i18n = t(lang);

const projects = [
  {
    name: 'pulpo.cloud',
    description:
      lang === 'en'
        ? 'Open Source POS, e-commerce & inventory management platform for SMEs'
        : 'Open-Source-Kassensystem, E-Commerce & Warenwirtschaft für KMU',
    tags: ['Astro', 'TypeScript', 'Directus', 'Docker'],
    url: 'https://pulpo.cloud',
    featured: true,
  },
  {
    name: 'beckernet.es',
    description:
      lang === 'en'
        ? 'Corporate website for an insurance consultancy'
        : 'Unternehmenswebsite für eine Versicherungsberatung',
    tags: ['Astro', 'Tailwind', 'CMS'],
    url: 'https://beckernet.es',
  },
  {
    name: 'seguros.beckernet.es',
    description:
      lang === 'en'
        ? 'Insurance comparison & quote platform'
        : 'Versicherungsvergleichs- & Angebotsplattform',
    tags: ['Astro', 'Directus', 'Tailwind'],
    url: 'https://seguros.beckernet.es',
  },
  {
    name: 'hektorysara.com',
    description:
      lang === 'en'
        ? 'Website for a dance academy'
        : 'Webseite für eine Tanzakademie',
    tags: ['Astro', 'Tailwind', 'CMS'],
    url: 'https://hektorysara.com',
  },
  {
    name: 'holacanterasclub.com',
    description:
      lang === 'en'
        ? 'Community website for a beach club'
        : 'Community-Webseite für einen Strandclub',
    tags: ['Astro', 'Tailwind'],
    url: 'https://holacanterasclub.com',
  },
  {
    name: 'elbuhotuerto.com',
    description:
      lang === 'en'
        ? 'Restaurant website with online presence'
        : 'Restaurant-Webseite mit Online-Präsenz',
    tags: ['Astro', 'Tailwind'],
    url: 'https://elbuhotuerto.com',
  },
];
---

<Base lang={lang} title={i18n.nav.projects} fullWidth>
  <section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
        {i18n.projects.label}
      </p>
      <h1
        class="font-display text-2xl sm:text-3xl md:text-4xl font-bold mt-4 tracking-tight text-heading"
      >
        {i18n.projects.headline}
      </h1>

      <div class="mt-12 space-y-6 stagger">
        {
          projects.map((project) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="reveal card-lift group grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-6 border border-border hover:border-primary/20 rounded-xl p-6 bg-white transition-all"
            >
              <div class="flex flex-col justify-center">
                <div class="flex items-center gap-3">
                  <h2 class="font-display text-lg font-bold tracking-tight text-heading group-hover:text-primary transition-colors">
                    {project.name}
                  </h2>
                  <Icon name="lucide:arrow-up-right" class="w-4 h-4 text-faint group-hover:text-primary transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </div>
                <p class="mt-2 text-sm text-muted leading-relaxed">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2 mt-4">
                  {project.tags.map((tag) => (
                    <span class="px-2.5 py-1 text-[11px] font-mono text-muted bg-surface border border-border rounded-md">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="hidden md:block">
                <BrowserMockup url={project.url.replace('https://', '')} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
