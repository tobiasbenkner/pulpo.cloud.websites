---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { Locale } from '@/lib/i18n';
import { t, getAlternateUrl } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  alternateUrl?: string;
}

const { lang, title, description, alternateUrl: explicitAlternate } = Astro.props;
const i18n = t(lang);
const pageTitle = title ? `${title} | ${i18n.site.title}` : i18n.site.title;
const pageDescription = description ?? i18n.site.description;
const alternateLang = lang === 'en' ? 'de' : 'en';
const alternateUrl = explicitAlternate ?? getAlternateUrl(Astro.url.pathname, alternateLang);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
  </head>
  <body
    class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col"
  >
    <Header lang={lang} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
