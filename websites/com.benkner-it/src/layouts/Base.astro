---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { Locale } from '@/lib/i18n';
import { t, getAlternateUrl } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  alternateUrl?: string;
  fullWidth?: boolean;
}

const {
  lang,
  title,
  description,
  alternateUrl: explicitAlternate,
  fullWidth = false,
} = Astro.props;
const i18n = t(lang);
const pageTitle = title ? `${title} — ${i18n.site.title}` : i18n.site.title;
const pageDescription = description ?? i18n.site.description;
const alternateLang = lang === 'en' ? 'de' : 'en';
const alternateUrl =
  explicitAlternate ?? getAlternateUrl(Astro.url.pathname, alternateLang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
  </head>
  <body class="bg-white text-body min-h-screen flex flex-col font-body">
    <Header
      lang={lang}
      currentPath={Astro.url.pathname}
      alternateUrl={alternateUrl}
    />
    {
      fullWidth ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="flex-1 w-full max-w-3xl mx-auto px-5 sm:px-8 pt-32 pb-20">
          <slot />
        </main>
      )
    }
    <Footer lang={lang} />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
