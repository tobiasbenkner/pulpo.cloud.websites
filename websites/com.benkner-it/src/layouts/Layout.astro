---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { type Language, resolveTranslations } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { sharedTranslations } from '@/lib/shared.i18n';

interface Props {
  title?: string;
  description?: string;
  lang: Language;
  routeKey: string;
  alternateUrl?: string;
}

const { lang, title, description, routeKey, alternateUrl: explicitAlternate } = Astro.props;
const t = resolveTranslations(sharedTranslations, lang);
const pageTitle = title
  ? `${title} — ${t.site.title}`
  : t.site.title;
const pageDescription = description || t.site.description;
const alternateLang: Language = lang === 'de' ? 'en' : 'de';
const alternateUrl = explicitAlternate || getTranslatedPath(routeKey, alternateLang) || getTranslatedPath('home', alternateLang);

const isFullWidth = ['home', 'services', 'projects', 'contact'].includes(routeKey);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
    {import.meta.env.PROD && (
      <script defer src="https://analytics.pulpo.cloud/script.js" data-website-id="f8bb41d1-6b2d-40f8-9b32-e0c317802377"></script>
    )}
  </head>
  <body class="bg-white text-body min-h-screen flex flex-col font-body">
    <Header lang={lang} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    {
      isFullWidth ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="flex-1 w-full max-w-3xl mx-auto px-5 sm:px-8 pt-32 pb-20">
          <slot />
        </main>
      )
    }
    <Footer lang={lang} />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
