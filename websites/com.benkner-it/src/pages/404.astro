---
import '@/styles/global.css';
import { Icon } from 'astro-icon/components';
import { config } from '@/data/config';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — {config.company}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  </head>
  <body class="bg-white text-body min-h-screen flex items-center justify-center font-body px-5">
    <div class="text-center max-w-md">
      <p class="font-display text-7xl font-extrabold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
        404
      </p>
      <h1 class="font-display text-xl font-bold text-heading mt-4">
        Seite nicht gefunden
      </h1>
      <p class="text-muted mt-3 leading-relaxed">
        Die angeforderte Seite existiert nicht oder wurde verschoben.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary-hover transition-colors"
        >
          <Icon name="lucide:home" class="w-4 h-4" />
          Zur Startseite
        </a>
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 px-6 py-3 border border-border text-body rounded-lg text-sm font-medium hover:border-border-hover transition-colors"
        >
          <Icon name="lucide:mail" class="w-4 h-4" />
          Kontakt
        </a>
      </div>
    </div>
  </body>
</html>
