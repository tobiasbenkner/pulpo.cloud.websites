---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import HomePage from '@/components/pages/HomePage.astro';
import BlogPage from '@/components/pages/BlogPage.astro';
import AboutPage from '@/components/pages/AboutPage.astro';
import CategoryPage from '@/components/pages/CategoryPage.astro';
import PostPage from '@/components/pages/PostPage.astro';
import ServicesPage from '@/components/pages/ServicesPage.astro';
import ProjectsPage from '@/components/pages/ProjectsPage.astro';
import ContactPage from '@/components/pages/ContactPage.astro';
import { locales, defaultLocale, categories } from '@/lib/i18n';
import type { Locale, Category } from '@/lib/i18n';
import { getPostsByLang, getAlternatePostUrl } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const paths: {
    params: { slug: string | undefined };
    props: Props;
  }[] = [];

  for (const lang of locales) {
    const prefix = lang === defaultLocale ? '' : `${lang}/`;
    const posts = await getPostsByLang(lang);

    paths.push({
      params: { slug: lang === defaultLocale ? undefined : lang },
      props: { page: 'home', lang, posts: posts.slice(0, 5) },
    });

    paths.push({
      params: { slug: `${prefix}services` },
      props: { page: 'services', lang },
    });

    paths.push({
      params: { slug: `${prefix}projects` },
      props: { page: 'projects', lang },
    });

    paths.push({
      params: { slug: `${prefix}contact` },
      props: { page: 'contact', lang },
    });

    paths.push({
      params: { slug: `${prefix}blog` },
      props: { page: 'blog', lang, posts },
    });

    paths.push({
      params: { slug: `${prefix}about` },
      props: { page: 'about', lang },
    });

    for (const category of categories) {
      const catPosts = posts.filter((p) => p.data.category === category);
      paths.push({
        params: { slug: `${prefix}${category}` },
        props: { page: 'category', lang, category, posts: catPosts },
      });
    }

    for (const post of posts) {
      const alternateUrl = await getAlternatePostUrl(post);
      paths.push({
        params: {
          slug: `${prefix}${post.data.category}/${post.data.permalink}`,
        },
        props: { page: 'post', lang, post, alternateUrl },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  page:
    | 'home'
    | 'services'
    | 'projects'
    | 'contact'
    | 'blog'
    | 'about'
    | 'category'
    | 'post';
  lang: Locale;
  posts?: CollectionEntry<'blog'>[];
  category?: Category;
  post?: CollectionEntry<'blog'>;
  alternateUrl?: string;
}

const { page, lang, posts, category, post, alternateUrl } = Astro.props;
---

{page === 'home' && posts && <HomePage lang={lang} posts={posts} />}
{page === 'services' && <ServicesPage lang={lang} />}
{page === 'projects' && <ProjectsPage lang={lang} />}
{page === 'contact' && <ContactPage lang={lang} />}
{page === 'blog' && posts && <BlogPage lang={lang} posts={posts} />}
{page === 'about' && <AboutPage lang={lang} />}
{
  page === 'category' && category && posts && (
    <CategoryPage lang={lang} category={category} posts={posts} />
  )
}
{
  page === 'post' && post && (
    <PostPage lang={lang} post={post} alternateUrl={alternateUrl} />
  )
}
