---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import type { AboutTranslations } from './about.i18n';

interface Props {
  lang: Language;
  t: AboutTranslations;
}

const { lang, t } = Astro.props;

const techStack = [
  { label: 'KI & Automatisierung', items: ['RAG', 'MCP Server', 'KI-Agents', 'LLM', 'N8N'] },
  { label: 'Frontend', items: ['Astro', 'Svelte', 'React', 'Next.js', 'Vue.js', 'Angular', 'TypeScript', 'Tailwind'] },
  { label: 'Backend', items: ['Node.js', 'NestJS', 'Go', 'Java', 'Spring Boot', 'C#', 'Python', 'GraphQL'] },
  { label: 'Datenbanken', items: ['PostgreSQL', 'MongoDB', 'Redis', 'DynamoDB', 'InfluxDB', 'Neo4J', 'MySQL'] },
  { label: 'Cloud & Infrastruktur', items: ['Azure', 'AWS', 'Docker', 'Kubernetes', 'Terraform', 'Traefik', 'Hetzner Cloud'] },
  { label: 'DevOps & CI/CD', items: ['GitHub Actions', 'GitLab CI', 'Azure DevOps', 'Jenkins', 'Ansible'] },
  { label: 'Sicherheit', items: ['WireGuard', 'Keycloak', 'Zitadel', 'OAuth2', 'OpenID Connect'] },
  { label: 'Monitoring', items: ['Grafana', 'Prometheus', 'Loki', 'Elasticsearch'] },
];
---

<section class="space-y-20">
  <!-- Hero: Photo + Bio -->
  <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-10 items-start">
    <!-- Photo placeholder -->
    <div class="flex flex-col items-center md:items-start">
      <div class="w-48 h-48 md:w-full md:h-auto md:aspect-square rounded-2xl bg-gradient-to-br from-primary-light to-secondary-light border border-border flex items-center justify-center">
        <div class="text-center">
          <Icon name="lucide:user" class="w-16 h-16 text-primary/30 mx-auto" />
          <p class="text-xs text-faint mt-2">{t.photoPlaceholder}</p>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div>
      <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
        {t.label}
      </p>
      <h1 class="font-display text-2xl sm:text-3xl font-bold mt-3 tracking-tight whitespace-pre-line leading-tight text-heading">
        {t.headline}
      </h1>
      <p class="text-body leading-relaxed mt-6">{t.bio}</p>
      <p class="text-muted leading-relaxed mt-4">{t.bio2}</p>
      <p class="text-muted leading-relaxed mt-4 italic">{t.personal}</p>
    </div>
  </div>

  <!-- Career Timeline -->
  <div>
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">
      {t.career.title}
    </h2>
    <div class="mt-8 space-y-0">
      {t.career.items.map((station: any) => (
        <div class="relative pl-8 pb-8 border-l-2 border-border last:border-l-transparent last:pb-0">
          <div class="absolute left-[-7px] top-1 w-3 h-3 rounded-full bg-white border-2 border-primary" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
            <h3 class="font-display font-bold text-heading">{station.company}</h3>
            <span class="text-xs font-mono text-faint">{station.period}</span>
          </div>
          <p class="text-xs font-mono text-primary mt-1">{station.industry}</p>
          <p class="text-sm text-muted mt-1.5 leading-relaxed">{station.role}</p>
        </div>
      ))}
      <div class="relative pl-8">
        <div class="absolute left-[-7px] top-1 w-3 h-3 rounded-full bg-surface border-2 border-border-hover" />
        <p class="text-sm text-faint italic">
          {lang === 'de'
            ? '+ weitere Stationen seit 2011 in den Bereichen E-Commerce, IoT, eMobilität und Forschung'
            : '+ more positions since 2011 in e-commerce, IoT, eMobility, and research'}
        </p>
      </div>
    </div>
  </div>

  <!-- How I Work -->
  <div>
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">
      {t.methodology.title}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8">
      {t.methodology.items.map((item: any) => (
        <div class="p-5 rounded-xl border border-border bg-surface/50">
          <h3 class="font-display font-bold text-heading text-sm">{item.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Education & Languages -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
    <div>
      <h2 class="font-display text-xl font-bold text-heading tracking-tight">
        {t.education.title}
      </h2>
      <ul class="mt-6 space-y-3">
        {t.education.items.map((item: any) => (
          <li class="flex items-start gap-3 text-sm text-body">
            <Icon name="lucide:graduation-cap" class="w-4 h-4 text-primary shrink-0 mt-0.5" />
            {item.degree}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-heading tracking-tight">
        {t.languages.title}
      </h2>
      <ul class="mt-6 space-y-3">
        {t.languages.items.map((item: any) => (
          <li class="flex items-center justify-between text-sm">
            <span class="text-body">{item.language}</span>
            <span class="text-xs font-mono text-faint">{item.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Tech Stack -->
  <div>
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">
      {t.techLabel}
    </h2>
    <div class="mt-8 space-y-5">
      {techStack.map((group) => (
        <div>
          <p class="text-[11px] font-mono uppercase tracking-wider text-faint mb-2.5">
            {group.label}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="px-3 py-1.5 text-sm text-body border border-border bg-surface/30 rounded-lg">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="p-8 rounded-xl bg-gradient-to-r from-primary-light to-secondary-light border border-primary-border text-center">
    <p class="font-display text-lg font-bold text-heading">
      {lang === 'de' ? 'Interesse an einer Zusammenarbeit?' : 'Interested in working together?'}
    </p>
    <p class="text-sm text-muted mt-2">
      {lang === 'de'
        ? 'Lassen Sie uns über Ihr Projekt sprechen.'
        : "Let's talk about your project."}
    </p>
    <a
      href={getTranslatedPath('contact', lang)}
      class="inline-flex items-center gap-2 mt-5 px-6 py-3 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary-hover transition-colors"
    >
      {lang === 'de' ? 'Kontakt aufnehmen' : 'Get in touch'}
      <Icon name="lucide:arrow-right" class="w-4 h-4" />
    </a>
  </div>
</section>
