---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import type { AboutTranslations } from './about.i18n';

interface Props {
  lang: Language;
  t: AboutTranslations;
}

const { lang, t } = Astro.props;

const techStack = [
  { label: 'KI & Automatisierung', items: ['RAG', 'MCP Server', 'KI-Agents', 'LLM', 'N8N'] },
  { label: 'Frontend', items: ['Astro', 'Svelte', 'React', 'Next.js', 'Vue.js', 'Angular', 'TypeScript', 'Tailwind'] },
  { label: 'Backend', items: ['Node.js', 'NestJS', 'Go', 'Java', 'Spring Boot', 'C#', 'Python', 'GraphQL'] },
  { label: 'Datenbanken', items: ['PostgreSQL', 'MongoDB', 'Redis', 'DynamoDB', 'InfluxDB', 'Neo4J', 'MySQL'] },
  { label: 'Cloud & Infrastruktur', items: ['Azure', 'AWS', 'Docker', 'Kubernetes', 'Terraform', 'Traefik', 'Hetzner Cloud'] },
  { label: 'DevOps & CI/CD', items: ['GitHub Actions', 'GitLab CI', 'Azure DevOps', 'Jenkins', 'Ansible'] },
  { label: 'Sicherheit', items: ['WireGuard', 'Keycloak', 'Zitadel', 'OAuth2', 'OpenID Connect'] },
  { label: 'Monitoring', items: ['Grafana', 'Prometheus', 'Loki', 'Elasticsearch'] },
];
---

<!-- Hero: Photo + Bio -->
<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 dot-grid overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-[400px] h-[400px] bg-primary/[0.04] rounded-full blur-[100px] -translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>

  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-8 items-start">
      <!-- Photo placeholder -->
      <div class="flex flex-col items-center md:items-start">
        <div class="w-40 h-40 md:w-full md:h-auto md:aspect-square rounded-2xl bg-gradient-to-br from-primary-light to-secondary-light border border-primary-border/30 flex items-center justify-center shadow-sm">
          <div class="text-center">
            <Icon name="lucide:user" class="w-14 h-14 text-primary/25 mx-auto" />
            <p class="text-[10px] text-faint mt-1.5">{t.photoPlaceholder}</p>
          </div>
        </div>
      </div>

      <!-- Bio -->
      <div>
        <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">{t.label}</p>
        <h1 class="font-display text-2xl sm:text-3xl font-bold mt-3 tracking-tight whitespace-pre-line leading-tight text-heading">
          {t.headline}
        </h1>
        <p class="text-body leading-relaxed mt-5">{t.bio}</p>
        <p class="text-muted leading-relaxed mt-3">{t.bio2}</p>
        <p class="text-sm text-primary font-medium mt-4 flex items-center gap-2">
          <Icon name="lucide:map-pin" class="w-4 h-4" />
          {t.personal}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Career Timeline -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden">
  <div class="absolute inset-0 cross-grid opacity-20 pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">{t.career.title}</h2>

    <div class="mt-10 space-y-0">
      {t.career.items.map((station: any, i: number) => (
        <div class="reveal relative pl-10 pb-10 border-l-2 border-primary/20 last:border-l-transparent last:pb-0">
          <div class="absolute left-[-8px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-primary shadow-sm" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
            <h3 class="font-display font-bold text-heading">{station.company}</h3>
            <span class="text-xs font-mono text-faint">{station.period}</span>
          </div>
          <span class="inline-block mt-1.5 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary bg-primary-light border border-primary-border rounded-md">
            {station.industry}
          </span>
          <p class="text-sm text-muted mt-2 leading-relaxed">{station.role}</p>
        </div>
      ))}
      <div class="relative pl-10">
        <div class="absolute left-[-8px] top-0.5 w-4 h-4 rounded-full bg-surface border-2 border-border-hover" />
        <p class="text-sm text-faint italic">
          {lang === 'de'
            ? '+ weitere Stationen seit 2011 in den Bereichen E-Commerce, IoT, eMobilität und Forschung'
            : '+ more positions since 2011 in e-commerce, IoT, eMobility, and research'}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- How I Work -->
<section class="relative py-20 sm:py-28 overflow-hidden gradient-mesh wave-divider">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">{t.methodology.title}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8 stagger">
      {t.methodology.items.map((item: any, i: number) => (
        <div class="reveal p-6 rounded-xl border border-border bg-white/80 backdrop-blur-sm card-lift">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center mb-4">
            <span class="font-mono text-sm font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="font-display font-bold text-heading text-sm">{item.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Education & Languages -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden">
  <div class="absolute inset-0 diagonal-lines opacity-[0.12] pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-surface via-surface/80 to-surface pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
      <div class="reveal">
        <h2 class="font-display text-xl font-bold text-heading tracking-tight">{t.education.title}</h2>
        <ul class="mt-6 space-y-4">
          {t.education.items.map((item: any) => (
            <li class="flex items-start gap-3 text-sm text-body">
              <div class="w-8 h-8 rounded-lg bg-primary-light border border-primary-border flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="lucide:graduation-cap" class="w-4 h-4 text-primary" />
              </div>
              <span class="pt-1">{item.degree}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <h2 class="font-display text-xl font-bold text-heading tracking-tight">{t.languages.title}</h2>
        <ul class="mt-6 space-y-4">
          {t.languages.items.map((item: any) => (
            <li class="flex items-center justify-between p-3 rounded-lg border border-border bg-white">
              <div class="flex items-center gap-3">
                <Icon name="lucide:languages" class="w-4 h-4 text-primary" />
                <span class="text-sm font-medium text-body">{item.language}</span>
              </div>
              <span class="text-xs font-mono text-primary bg-primary-light px-2 py-0.5 rounded-full">{item.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Tech Stack -->
<section class="relative py-20 sm:py-28 overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-30 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-white/40 to-white pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-secondary/[0.03] rounded-full blur-[100px] translate-y-1/3 translate-x-1/4 pointer-events-none"></div>

  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <h2 class="font-display text-xl font-bold text-heading tracking-tight">{t.techLabel}</h2>

    <div class="mt-8 space-y-6 stagger">
      {techStack.map((group) => (
        <div class="reveal">
          <p class="text-[11px] font-mono uppercase tracking-wider text-faint mb-2.5">
            {group.label}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="px-3 py-1.5 text-sm text-body border border-border bg-white/80 rounded-lg shadow-sm hover:border-primary/30 hover:shadow-md transition-all">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="relative py-20 sm:py-28 bg-gradient-to-br from-primary to-secondary overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-10 pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <h2 class="reveal font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
      {lang === 'de' ? 'Interesse an einer Zusammenarbeit?' : 'Interested in working together?'}
    </h2>
    <p class="reveal text-white/70 mt-4 text-lg">
      {lang === 'de' ? 'Lassen Sie uns über Ihr Projekt sprechen.' : "Let's talk about your project."}
    </p>
    <div class="reveal mt-8">
      <a
        href={getTranslatedPath('contact', lang)}
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-primary rounded-lg text-sm font-semibold hover:bg-white/90 transition-colors shadow-lg"
      >
        {lang === 'de' ? 'Kontakt aufnehmen' : 'Get in touch'}
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
