---
import type { Language } from '@/lib/i18n';
import type { AboutTranslations } from './about.i18n';

interface Props {
  lang: Language;
  t: AboutTranslations;
}

const { lang, t } = Astro.props;

const techStack = [
  {
    label: 'Infrastructure',
    items: ['Docker', 'Kubernetes', 'Traefik', 'Terraform'],
  },
  { label: 'CI/CD', items: ['GitHub Actions', 'GitLab CI'] },
  {
    label: 'Frontend',
    items: ['Astro', 'TypeScript', 'Tailwind CSS', 'React'],
  },
  { label: 'Backend', items: ['Node.js', 'Go', 'PostgreSQL'] },
  { label: 'Monitoring', items: ['Grafana', 'Prometheus', 'Loki'] },
];
---

<section>
  <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
    {t.label}
  </p>
  <h1
    class="font-display text-2xl sm:text-3xl font-bold mt-4 tracking-tight whitespace-pre-line leading-tight text-heading"
  >
    {t.headline}
  </h1>

  <div class="mt-10 space-y-4">
    <p class="text-body leading-relaxed">{t.bio}</p>
    <p class="text-muted leading-relaxed text-sm">
      {t.bio2}
    </p>
  </div>

  <div class="mt-14">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em] mb-8">
      {t.techLabel}
    </p>
    <div class="space-y-6">
      {
        techStack.map((group) => (
          <div>
            <p class="text-[11px] font-mono uppercase tracking-wider text-faint mb-3">
              {group.label}
            </p>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="px-3 py-1.5 text-sm text-body border border-border bg-surface rounded-lg">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
