---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { config } from '@/data/config';
import type { ContactTranslations } from './contact.i18n';

interface Props {
  lang: Language;
  t: ContactTranslations;
}

const { lang, t } = Astro.props;
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto">
      <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
        {t.label}
      </p>
      <h1
        class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold mt-6 tracking-tight text-heading"
      >
        {t.headline1}<br />
        <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{t.headline2}</span>
      </h1>
      <p class="text-lg text-muted mt-4">
        {t.subtitle}
      </p>
    </div>

    <!-- Contact Cards + Availability -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-16">
      <!-- Direct Contact -->
      <div class="p-8 rounded-xl border border-border bg-white">
        <h2 class="font-display text-lg font-bold text-heading">
          {t.directContact.title}
        </h2>
        <div class="mt-6 space-y-5">
          <a
            href={`mailto:${config.email}`}
            class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-primary-light/30 transition-all group"
          >
            <div class="w-10 h-10 rounded-lg bg-primary-light flex items-center justify-center shrink-0">
              <Icon name="lucide:mail" class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="text-sm font-medium text-heading group-hover:text-primary transition-colors">{lang === 'de' ? 'E-Mail' : 'Email'}</p>
              <p class="text-sm text-muted font-mono">{config.email}</p>
            </div>
          </a>

          {config.phone && (
            <a
              href={`tel:${config.phone.replace(/\s/g, '')}`}
              class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-primary-light/30 transition-all group"
            >
              <div class="w-10 h-10 rounded-lg bg-primary-light flex items-center justify-center shrink-0">
                <Icon name="lucide:phone" class="w-5 h-5 text-primary" />
              </div>
              <div>
                <p class="text-sm font-medium text-heading group-hover:text-primary transition-colors">{lang === 'de' ? 'Telefon' : 'Phone'}</p>
                <p class="text-sm text-muted font-mono">{config.phone}</p>
              </div>
            </a>
          )}

          {config.whatsapp && (
            <a
              href={`https://wa.me/${config.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-[#25d366]/30 hover:bg-[#25d366]/5 transition-all group"
            >
              <div class="w-10 h-10 rounded-lg bg-[#25d366]/10 flex items-center justify-center shrink-0">
                <Icon name="mdi:whatsapp" class="w-5 h-5 text-[#25d366]" />
              </div>
              <div>
                <p class="text-sm font-medium text-heading group-hover:text-[#25d366] transition-colors">WhatsApp</p>
                <p class="text-sm text-muted font-mono">{lang === 'de' ? 'Nachricht senden' : 'Send a message'}</p>
              </div>
            </a>
          )}
        </div>
      </div>

      <!-- Availability -->
      <div class="p-8 rounded-xl border border-border bg-white">
        <h2 class="font-display text-lg font-bold text-heading">
          {t.availability.title}
        </h2>
        <div class="mt-6 space-y-5">
          <div class="flex items-center gap-3">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            <p class="text-sm font-medium text-heading">{t.availability.status}</p>
          </div>

          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3 text-sm text-muted">
              <Icon name="lucide:globe" class="w-4 h-4 text-primary shrink-0" />
              {t.availability.remote}
            </div>
            <div class="flex items-center gap-3 text-sm text-muted">
              <Icon name="lucide:map-pin" class="w-4 h-4 text-primary shrink-0" />
              {t.availability.onsite}
            </div>
            <div class="flex items-center gap-3 text-sm text-muted">
              <Icon name="lucide:languages" class="w-4 h-4 text-primary shrink-0" />
              {t.availability.languages}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- What happens next -->
    <div class="mt-16">
      <h2 class="font-display text-lg font-bold text-heading text-center">
        {t.response.title}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8">
        {t.response.steps.map((step: any, i: number) => (
          <div class="text-center">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary text-white font-display font-bold text-sm flex items-center justify-center mx-auto">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="font-display font-bold text-heading text-sm mt-4">{step.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
