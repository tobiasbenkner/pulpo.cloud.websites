---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { config } from '@/data/config';
import type { ContactTranslations } from './contact.i18n';

interface Props {
  lang: Language;
  t: ContactTranslations;
}

const { lang, t } = Astro.props;
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28 min-h-[70dvh] flex items-center">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 w-full text-center">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
      {t.label}
    </p>
    <h1
      class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold mt-6 tracking-tight text-heading"
    >
      {t.headline1}<br />
      <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{t.headline2}</span>
    </h1>
    <p class="text-lg text-muted mt-4">
      {t.subtitle}
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-6">
      <a
        href={`mailto:${config.email}`}
        class="inline-flex items-center gap-3 text-lg font-mono text-primary hover:text-primary-hover transition-colors group"
      >
        <Icon name="lucide:mail" class="w-5 h-5" />
        {config.email}
      </a>
      {config.phone && (
        <a
          href={`tel:${config.phone.replace(/\s/g, '')}`}
          class="inline-flex items-center gap-3 text-lg font-mono text-muted hover:text-primary transition-colors"
        >
          <Icon name="lucide:phone" class="w-5 h-5" />
          {config.phone}
        </a>
      )}
      {config.whatsapp && (
        <a
          href={`https://wa.me/${config.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 text-lg font-mono text-muted hover:text-[#25d366] transition-colors"
        >
          <Icon name="mdi:whatsapp" class="w-5 h-5" />
          WhatsApp
        </a>
      )}
    </div>
  </div>
</section>
