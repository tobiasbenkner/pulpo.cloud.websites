---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { config } from '@/data/config';
import type { ContactTranslations } from './contact.i18n';

interface Props {
  lang: Language;
  t: ContactTranslations;
}

const { lang, t } = Astro.props;
---

<!-- Header -->
<section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 dot-grid overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white pointer-events-none"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-gradient-to-b from-primary/[0.04] to-secondary/[0.03] rounded-full blur-[100px] -translate-y-1/3 pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-5 sm:px-8 text-center">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">{t.label}</p>
    <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold mt-6 tracking-tight text-heading">
      {t.headline1}<br />
      <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{t.headline2}</span>
    </h1>
    <p class="text-lg text-muted mt-4">{t.subtitle}</p>
  </div>
</section>

<!-- Contact Cards + Availability -->
<section class="relative py-16 sm:py-20 overflow-hidden gradient-mesh">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Direct Contact -->
      <div class="reveal p-8 rounded-xl border border-border bg-white/80 backdrop-blur-sm shadow-sm card-lift">
        <h2 class="font-display text-lg font-bold text-heading">{t.directContact.title}</h2>
        <div class="mt-6 space-y-4">
          <a
            href={`mailto:${config.email}`}
            class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-primary-light/30 hover:shadow-sm transition-all group"
          >
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center shrink-0">
              <Icon name="lucide:mail" class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="text-sm font-medium text-heading group-hover:text-primary transition-colors">{lang === 'de' ? 'E-Mail' : 'Email'}</p>
              <p class="text-sm text-muted font-mono">{config.email}</p>
            </div>
            <Icon name="lucide:arrow-right" class="w-4 h-4 text-faint group-hover:text-primary ml-auto shrink-0 transition-colors" />
          </a>

          {config.phone && (
            <a
              href={`tel:${config.phone.replace(/\s/g, '')}`}
              class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-primary-light/30 hover:shadow-sm transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center shrink-0">
                <Icon name="lucide:phone" class="w-5 h-5 text-primary" />
              </div>
              <div>
                <p class="text-sm font-medium text-heading group-hover:text-primary transition-colors">{lang === 'de' ? 'Telefon' : 'Phone'}</p>
                <p class="text-sm text-muted font-mono">{config.phone}</p>
              </div>
              <Icon name="lucide:arrow-right" class="w-4 h-4 text-faint group-hover:text-primary ml-auto shrink-0 transition-colors" />
            </a>
          )}

          {config.whatsapp && (
            <a
              href={`https://wa.me/${config.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-lg border border-border hover:border-[#25d366]/30 hover:bg-[#25d366]/5 hover:shadow-sm transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-[#25d366]/10 flex items-center justify-center shrink-0">
                <Icon name="mdi:whatsapp" class="w-5 h-5 text-[#25d366]" />
              </div>
              <div>
                <p class="text-sm font-medium text-heading group-hover:text-[#25d366] transition-colors">WhatsApp</p>
                <p class="text-sm text-muted font-mono">{lang === 'de' ? 'Nachricht senden' : 'Send a message'}</p>
              </div>
              <Icon name="lucide:arrow-right" class="w-4 h-4 text-faint group-hover:text-[#25d366] ml-auto shrink-0 transition-colors" />
            </a>
          )}
        </div>
      </div>

      <!-- Availability -->
      <div class="reveal p-8 rounded-xl border border-primary/15 bg-white/80 backdrop-blur-sm shadow-sm card-lift">
        <h2 class="font-display text-lg font-bold text-heading">{t.availability.title}</h2>
        <div class="mt-6 space-y-6">
          <div class="flex items-center gap-3 p-3 rounded-lg bg-green-50 border border-green-200">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            <p class="text-sm font-medium text-green-800">{t.availability.status}</p>
          </div>

          <div class="space-y-4 pt-1">
            <div class="flex items-center gap-4 text-sm text-body">
              <div class="w-9 h-9 rounded-lg bg-primary-light flex items-center justify-center shrink-0">
                <Icon name="lucide:globe" class="w-4 h-4 text-primary" />
              </div>
              {t.availability.remote}
            </div>
            <div class="flex items-center gap-4 text-sm text-body">
              <div class="w-9 h-9 rounded-lg bg-primary-light flex items-center justify-center shrink-0">
                <Icon name="lucide:map-pin" class="w-4 h-4 text-primary" />
              </div>
              {t.availability.onsite}
            </div>
            <div class="flex items-center gap-4 text-sm text-body">
              <div class="w-9 h-9 rounded-lg bg-primary-light flex items-center justify-center shrink-0">
                <Icon name="lucide:languages" class="w-4 h-4 text-primary" />
              </div>
              {t.availability.languages}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What happens next -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden">
  <div class="absolute inset-0 cross-grid opacity-20 pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
    <h2 class="font-display text-lg font-bold text-heading text-center">{t.response.title}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mt-12">
      {t.response.steps.map((step: any, i: number) => (
        <div class="reveal relative text-center">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-secondary text-white font-display font-bold text-sm flex items-center justify-center mx-auto shadow-lg shadow-primary/20">
            {String(i + 1).padStart(2, '0')}
          </div>
          {i < 2 && (
            <div class="hidden sm:block absolute top-6 left-[calc(50%+36px)] w-[calc(100%-72px)] border-t-2 border-dashed border-primary/20"></div>
          )}
          <h3 class="font-display font-bold text-heading text-sm mt-5">{step.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
