---
import { Icon } from 'astro-icon/components';
import PostCard from '@/components/PostCard.astro';
import BrowserMockup from '@/components/BrowserMockup.astro';
import type { Language } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import { config } from '@/data/config';
import { getPostsByLang } from '@/lib/posts';
import type { HomeTranslations } from './home.i18n';

import { Image } from 'astro:assets';
import heroImage from '@/assets/hero.png';
import screenshotPulpo from '@/assets/screenshots/pulpo-cloud.png';
import screenshotFinca from '@/assets/screenshots/fincaloscastanos.png';
import screenshotBuho from '@/assets/screenshots/elbuhotuerto.png';

interface Props {
  lang: Language;
  t: HomeTranslations;
}

const { lang, t } = Astro.props;
const posts = await getPostsByLang(lang);

const services = [
  { key: 'mvp' as const, featured: true, icon: 'rocket' },
  { key: 'websites' as const, featured: false, icon: 'globe' },
  { key: 'consulting' as const, featured: false, icon: 'users' },
] as const;

const projects = [
  {
    name: 'pulpo.cloud',
    desc: lang === 'de'
      ? 'Open-Source-Kassensystem, E-Commerce & Warenwirtschaft für KMU'
      : 'Open Source POS, e-commerce & inventory management for SMEs',
    url: 'https://pulpo.cloud',
    tags: ['Astro', 'Svelte', 'Go', 'Docker'],
    type: 'MVP',
    screenshot: screenshotPulpo,
  },
  {
    name: 'fincaloscastanos.com',
    desc: lang === 'de'
      ? 'Webseite für eine Ferienfinca mit Buchungsanbindung'
      : 'Holiday finca website with booking integration',
    url: 'https://fincaloscastanos.com',
    tags: ['Astro', 'Tailwind'],
    type: lang === 'de' ? 'Webseite' : 'Website',
    screenshot: screenshotFinca,
  },
  {
    name: 'elbuhotuerto.com',
    desc: lang === 'de'
      ? 'Restaurant-Webseite mit Online-Speisekarte und Reservierung'
      : 'Restaurant website with online menu and reservations',
    url: 'https://elbuhotuerto.com',
    tags: ['Astro', 'Tailwind', 'CMS'],
    type: lang === 'de' ? 'Webseite' : 'Website',
    screenshot: screenshotBuho,
  },
];
---

<!-- ═══════════════════════════════════ HERO ═══ -->
<section class="relative pt-20 pb-12 sm:pt-40 sm:pb-24 dot-grid overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-primary/[0.04] to-secondary/[0.03] rounded-full blur-[100px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-secondary/[0.03] rounded-full blur-[80px] translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-8 lg:gap-16 items-center">
      <!-- Hero image: above text on mobile, right side on desktop -->
      <div class="lg:hidden">
        <Image
          src={heroImage}
          alt={lang === 'de' ? 'Von der Idee zum fertigen Produkt in 7 Tagen' : 'From idea to finished product in 7 days'}
          widths={[400, 800, 1326]}
          sizes="(min-width: 640px) 80vw, 100vw"
          class="w-full sm:max-w-sm sm:mx-auto h-auto"
        />
      </div>

      <div>
        <div class="hero-animate hidden lg:block">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-light border border-primary-border text-primary text-xs font-mono font-medium uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            {t.hero.label}
          </span>
        </div>

        <h1
          class="hero-animate font-display text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight mt-3 sm:mt-6 tracking-tight text-heading"
        >
          {t.hero.line1}<br />
          {t.hero.line2}<br />
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{t.hero.line3}</span>
        </h1>

        <div class="hero-animate">
          <p class="text-base sm:text-lg text-muted mt-3 sm:mt-6 max-w-lg leading-relaxed">
            {t.hero.subtitle}
          </p>
        </div>

        <div class="hero-animate flex flex-col sm:flex-row gap-3 mt-6 sm:mt-10">
          <a
            href={getTranslatedPath('contact', lang)}
            class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-primary-hover text-white px-7 py-3.5 rounded-lg font-semibold text-sm hover:shadow-lg hover:shadow-primary/20 transition-all"
          >
            {t.hero.cta}
            <Icon name="lucide:arrow-right" class="w-4 h-4 ml-2" />
          </a>
          <a
            href={getTranslatedPath('services', lang)}
            class="inline-flex items-center justify-center border border-border px-7 py-3.5 rounded-lg text-sm font-medium text-body hover:border-primary/30 hover:bg-primary-light/50 transition-all"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="hero-animate hidden lg:block">
        <Image
          src={heroImage}
          alt={lang === 'de' ? 'Von der Idee zum fertigen Produkt in 7 Tagen' : 'From idea to finished product in 7 days'}
          widths={[600, 800, 1326]}
          sizes="50vw"
          class="w-full h-auto"
        />
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════ TRUST INDICATORS ═══ -->
<section class="py-8 border-y border-border bg-surface/50">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex flex-wrap justify-center gap-8 sm:gap-16 text-center">
      <div class="reveal">
        <p class="font-display text-2xl font-bold text-heading">{config.stats.projectsShipped}</p>
        <p class="text-xs text-muted mt-1 font-mono uppercase tracking-wider">{t.stats.projectsShipped}</p>
      </div>
      <div class="reveal">
        <p class="font-display text-2xl font-bold text-heading">{config.mvpDays}</p>
        <p class="text-xs text-muted mt-1 font-mono uppercase tracking-wider">{t.stats.daysForMvp}</p>
      </div>
      <div class="reveal">
        <p class="font-display text-2xl font-bold text-heading">{config.stats.yearsExperience}</p>
        <p class="text-xs text-muted mt-1 font-mono uppercase tracking-wider">{t.stats.yearsExperience}</p>
      </div>
      <div class="reveal">
        <p class="font-display text-2xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">100%</p>
        <p class="text-xs text-muted mt-1 font-mono uppercase tracking-wider">{t.stats.fixedPrice}</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════ SERVICES TEASER ═══ -->
<section class="relative py-20 sm:py-28 overflow-hidden gradient-mesh wave-divider">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="reveal flex items-end justify-between">
      <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">{t.services.label}</p>
      <a href={getTranslatedPath('services', lang)} class="hidden sm:inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors">
        {t.viewAll}
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-12 stagger">
      {
        services.map(({ key, featured, icon }) => {
          const svc = t.services[key];
          return (
            <a
              href={getTranslatedPath('services', lang)}
              class:list={[
                'reveal card-lift relative p-7 rounded-xl border bg-white flex flex-col group',
                featured ? 'border-primary/25 shadow-sm' : 'border-border hover:border-primary/20',
              ]}
            >
              {featured && (
                <span class="absolute -top-3 left-6 px-3 py-1 bg-gradient-to-r from-primary to-secondary text-white text-[10px] font-mono font-semibold uppercase tracking-wider rounded-full">
                  {t.services.recommended}
                </span>
              )}
              <div class:list={[
                'w-10 h-10 rounded-lg flex items-center justify-center mb-4',
                featured ? 'bg-gradient-to-br from-primary/10 to-secondary/10' : 'bg-surface',
              ]}>
                {icon === 'rocket' && <Icon name="lucide:rocket" class="w-5 h-5 text-primary" />}
                {icon === 'globe' && <Icon name="lucide:globe" class="w-5 h-5 text-secondary" />}
                {icon === 'users' && <Icon name="lucide:briefcase" class="w-5 h-5 text-primary" />}
              </div>
              <h3 class="font-display text-lg font-bold tracking-tight text-heading group-hover:text-primary transition-colors">{svc.title}</h3>
              <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-2xl font-extrabold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{svc.price}</span>
                {svc.period && <span class="text-sm text-faint font-mono">/ {svc.period}</span>}
              </div>
              <p class="mt-3 text-sm text-muted leading-relaxed flex-1">{svc.description}</p>
              <div class="mt-5 pt-4 border-t border-border flex items-center gap-2 text-sm font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                {t.learnMore}
                <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<!-- ══════════════════════════ PROJECTS ═══ -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden angle-divider-white">
  <div class="absolute inset-0 cross-grid opacity-20 pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
    <div class="reveal">
      <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">{t.projects.label}</p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold mt-4 tracking-tight text-heading">
        {t.projects.headline}
      </h2>
    </div>

    <div class="mt-12 space-y-6 stagger">
      {
        projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal card-lift group grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-6 border border-border hover:border-primary/20 rounded-xl p-6 bg-white transition-all"
          >
            <div class="flex flex-col justify-center">
              <div class="flex items-center gap-3">
                <h3 class="font-display text-lg font-bold tracking-tight text-heading group-hover:text-primary transition-colors">
                  {p.name}
                </h3>
                <span class="px-2 py-0.5 text-[10px] font-mono text-primary bg-primary-light border border-primary-border rounded-md uppercase tracking-wider">
                  {p.type}
                </span>
                <Icon name="lucide:arrow-up-right" class="w-4 h-4 text-faint group-hover:text-primary transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
              <p class="mt-2 text-sm text-muted leading-relaxed">{p.desc}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                {p.tags.map((tag) => (
                  <span class="px-2.5 py-1 text-[11px] font-mono text-muted bg-surface border border-border rounded-md">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <div class="hidden md:block">
              <BrowserMockup url={p.url.replace('https://', '')} screenshot={p.screenshot} />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ BLOG TEASER ═══ -->
{
  posts.length > 0 && (
    <section class="relative py-20 sm:py-28 overflow-hidden">
      <div class="absolute inset-0 diagonal-lines opacity-[0.15] pointer-events-none" />
      <div class="absolute inset-0 bg-gradient-to-b from-white via-white/80 to-white pointer-events-none" />
      <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
        <div class="reveal flex items-end justify-between">
          <div>
            <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">{t.blogSection.label}</p>
            <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold mt-4 tracking-tight text-heading">
              {t.blogSection.headline}
            </h2>
          </div>
          <a
            href={getTranslatedPath('blog', lang)}
            class="hidden sm:inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors shrink-0 ml-8"
          >
            {t.viewAll}
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 stagger">
          {posts.slice(0, 4).map((post) => (
            <div class="reveal">
              <PostCard post={post} lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- ═══════════════════════════════════ CTA ═══ -->
<section class="relative py-20 sm:py-28 bg-gradient-to-br from-primary to-secondary overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-10 pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8 text-center">
    <h2 class="reveal font-display text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
      {t.contact.headline1} {t.contact.headline2}
    </h2>
    <p class="reveal text-white/70 mt-4 text-lg">{t.contact.subtitle}</p>
    <div class="reveal mt-8">
      <a
        href={getTranslatedPath('contact', lang)}
        class="inline-flex items-center justify-center bg-white text-primary px-8 py-4 rounded-lg font-semibold text-sm hover:bg-white/90 transition-colors shadow-lg"
      >
        {t.hero.cta}
        <Icon name="lucide:arrow-right" class="w-4 h-4 ml-2" />
      </a>
    </div>
  </div>
</section>
