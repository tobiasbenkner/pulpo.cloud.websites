---
import { Icon } from 'astro-icon/components';
import type { Language } from '@/lib/i18n';
import { getTranslatedPath } from '@/lib/registry';
import type { ServicesTranslations } from './services.i18n';

interface Props {
  lang: Language;
  t: ServicesTranslations;
}

const { lang, t } = Astro.props;
---

<!-- Leistungen -->
<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 dot-grid overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-bl from-primary/[0.04] to-secondary/[0.03] rounded-full blur-[100px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
      {t.label}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-12 stagger">
      {
        (
          [
            { key: 'mvp' as const, featured: true },
            { key: 'websites' as const, featured: false },
            { key: 'consulting' as const, featured: false },
          ] as const
        ).map(({ key, featured }) => {
          const svc = t[key];
          return (
            <div
              class:list={[
                'reveal card-lift relative p-7 rounded-xl border bg-white flex flex-col',
                featured
                  ? 'border-primary/25 shadow-sm'
                  : 'border-border',
              ]}
            >
              {featured && (
                <span class="absolute -top-3 left-6 px-3 py-1 bg-gradient-to-r from-primary to-secondary text-white text-[10px] font-mono font-semibold uppercase tracking-wider rounded-full">
                  {t.recommended}
                </span>
              )}

              <h3 class="font-display text-lg font-bold tracking-tight text-heading">
                {svc.title}
              </h3>

              <div class="mt-4 flex items-baseline gap-2">
                <span class="font-display text-3xl font-extrabold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                  {svc.price}
                </span>
                {svc.period && (
                  <span class="text-sm text-faint font-mono">
                    / {svc.period}
                  </span>
                )}
              </div>

              <p class="mt-4 text-sm text-muted leading-relaxed">
                {svc.description}
              </p>

              <div class="mt-6 pt-6 border-t border-border flex-1">
                <ul class="space-y-3">
                  {svc.features.map((f: string) => (
                    <li class="flex items-start gap-3 text-sm text-body">
                      <Icon name="lucide:check" class="w-4 h-4 text-primary shrink-0 mt-0.5" />
                      {f}
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={getTranslatedPath('contact', lang)}
                class:list={[
                  'mt-8 inline-flex items-center justify-center py-3.5 rounded-lg text-sm font-semibold transition-all',
                  featured
                    ? 'bg-gradient-to-r from-primary to-primary-hover text-white hover:shadow-lg hover:shadow-primary/20'
                    : 'border border-border text-body hover:border-primary hover:text-primary',
                ]}
              >
                {svc.cta}
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<!-- Process -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden wave-divider-white">
  <div class="absolute inset-0 cross-grid opacity-20 pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
      {t.process.label}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-12">
      {
        (
          [
            { key: 'consultation' as const, icon: 'lucide:message-circle', num: '01' },
            { key: 'concept' as const, icon: 'lucide:file-text', num: '02' },
            { key: 'implementation' as const, icon: 'lucide:code', num: '03' },
            { key: 'delivery' as const, icon: 'lucide:rocket', num: '04' },
          ] as const
        ).map(({ key, icon, num }) => {
          const step = t.process.steps[key];
          return (
            <div class="reveal relative">
              <span class="font-mono text-4xl font-extrabold bg-gradient-to-r from-primary/15 to-secondary/15 bg-clip-text text-transparent">{num}</span>
              <div class="mt-3 flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-white border border-border flex items-center justify-center shadow-sm">
                  <Icon name={icon} class="w-4 h-4 text-primary" />
                </div>
                <h3 class="font-display text-base font-bold tracking-tight text-heading">{step.title}</h3>
              </div>
              <p class="mt-3 text-sm text-muted leading-relaxed">{step.description}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<!-- Add-ons -->
<section class="relative py-20 sm:py-28 overflow-hidden gradient-mesh">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
      {t.addons.label}
    </p>

    <!-- Webseiten Add-ons -->
    <h3 class="font-display text-lg font-bold text-heading mt-8">{t.addons.websiteLabel}</h3>
    <p class="text-muted mt-2 text-sm">{t.addons.websiteSubtitle}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8 stagger">
      {
        (['hosting', 'maintenance'] as const).map((key) => {
          const addon = t.addons[key];
          return (
            <div class="reveal p-7 rounded-xl border border-border bg-white/80 backdrop-blur-sm flex flex-col card-lift">
              <h4 class="font-display text-base font-bold tracking-tight text-heading">
                {addon.title}
              </h4>
              <p class="mt-2 font-mono text-sm bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent font-semibold">
                {addon.price}
              </p>
              <p class="mt-3 text-sm text-muted leading-relaxed">
                {addon.description}
              </p>
              <div class="mt-5 pt-5 border-t border-border flex-1">
                <ul class="space-y-2.5">
                  {addon.features.map((f: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-body">
                      <Icon name="lucide:check" class="w-3.5 h-3.5 text-primary shrink-0 mt-0.5" />
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- MVP Add-on -->
    <h3 class="font-display text-lg font-bold text-heading mt-14">{t.addons.mvpLabel}</h3>
    <p class="text-muted mt-2 text-sm">{t.addons.mvpSubtitle}</p>

    <div class="mt-8">
      <div class="reveal p-7 rounded-xl border border-primary/20 bg-gradient-to-r from-primary-light/50 to-secondary-light/50 backdrop-blur-sm flex flex-col md:flex-row md:items-center gap-6 card-lift">
        <div class="flex-1">
          <h4 class="font-display text-base font-bold tracking-tight text-heading">
            {t.addons.mvpDevelopment.title}
          </h4>
          <p class="mt-2 font-mono text-sm bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent font-semibold">
            {t.addons.mvpDevelopment.price}
          </p>
          <p class="mt-3 text-sm text-muted leading-relaxed">
            {t.addons.mvpDevelopment.description}
          </p>
        </div>
        <div class="md:w-64 shrink-0">
          <ul class="space-y-2.5">
            {t.addons.mvpDevelopment.features.map((f: string) => (
              <li class="flex items-start gap-2.5 text-sm text-body">
                <Icon name="lucide:check" class="w-3.5 h-3.5 text-primary shrink-0 mt-0.5" />
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="relative py-20 sm:py-28 bg-surface overflow-hidden">
  <div class="absolute inset-0 diagonal-lines opacity-[0.12] pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-surface via-surface/80 to-surface pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <p class="font-mono text-faint text-xs uppercase tracking-[0.2em]">
      {t.faq.label}
    </p>

    <div class="mt-12 space-y-4">
      {
        (
          [
            'q1' as const,
            'q2' as const,
            'q3' as const,
            'q4' as const,
            'q5' as const,
            'q6' as const,
          ] as const
        ).map((key) => {
          const item = t.faq.items[key];
          return (
            <details class="reveal group rounded-xl border border-border bg-white shadow-sm">
              <summary class="cursor-pointer select-none px-6 py-5 flex items-center justify-between gap-4 font-display text-sm font-semibold text-heading">
                {item.question}
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-faint shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-6 pb-5 text-sm text-muted leading-relaxed">
                {item.answer}
              </div>
            </details>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={getTranslatedPath('contact', lang)}
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg text-sm font-semibold bg-gradient-to-r from-primary to-primary-hover text-white hover:shadow-lg hover:shadow-primary/20 transition-all"
      >
        {lang === 'de' ? 'Jetzt Erstgespräch vereinbaren' : 'Schedule a Free Consultation'}
      </a>
    </div>
  </div>
</section>
